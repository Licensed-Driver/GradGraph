<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- So the same DLL works in Unity and regular .NET -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- C# 9 is the newest version Unity supports womp womp -->
    <LangVersion>9.0</LangVersion>
    <RootNamespace>GradGraph</RootNamespace>
    <AssemblyName>GradGraph</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Metadata -->
    <PackageId>GradGraph</PackageId>
    <Version>0.2.0</Version>
    <Authors>Licensed-Driver</Authors>
    <Description>Exact forward-mode automatic differentiation (value, gradient and Hessian) on top of MathNet.Numerics.</Description>
    <PackageTags>autodiff;automatic-differentiation;gradient;hessian;jacobian;mathnet;unity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Licensed-Driver/GradGraph</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Licensed-Driver/GradGraph</PackageProjectUrl>
    <PackageReadmeFile Condition="Exists('../../README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../README.md')">
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
